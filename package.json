{
  "name": "@flip-forge/vue-flip-forge",
  "version": "0.3.1",
  "type": "module",
  "private": false,
  "description": "Lightweight vue component to generate a simple flipbook from a list of images.",
  "keywords": [
    "flipbook",
    "catalog",
    "catalogue",
    "component",
    "book",
    "page",
    "flip",
    "turn",
    "3d",
    "vue3"
  ],
  "homepage": "https://github.com/flip-forge/vue-flip-forge#README",
  "repository": {
    "type": "git",
    "url": "https://github.com/flip-forge/vue-flip-forge.git"
  },
  "license": "GPL-3.0-only",
  "author": "alexkiro",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "style:fix": "run-s -c lint format",
    "style:check": "run-s -c lint:check format:check"
  },
  "peerDependencies": {
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node22": "22.0.5",
    "@types/jsdom": "28.0.1",
    "@types/node": "25.5.0",
    "@vitejs/plugin-vue": "6.0.5",
    "@vitest/eslint-plugin": "1.6.12",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.0",
    "@vueuse/router": "14.2.1",
    "cypress": "15.15.0",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "6.2.0",
    "eslint-plugin-vue": "10.8.0",
    "jsdom": "29.0.1",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.1",
    "sass": "1.98.0",
    "start-server-and-test": "2.1.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.1",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-vue-devtools": "8.1.0",
    "vitest": "4.1.0",
    "vue": "3.5.30",
    "vue-router": "5.0.4",
    "vue-tsc": "3.2.6"
  },
  "types": "./dist/src/index.d.ts",
  "main": "./dist/vue-flip-forge.umd.cjs",
  "browser": "./dist/vue-flip-forge.umd.cjs",
  "module": "./dist/vue-flip-forge.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/vue-flip-forge.js",
      "require": "./dist/vue-flip-forge.umd.js"
    },
    "./dist/vue-flip-forge.css": "./dist/vue-flip-forge.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20 <=25"
  }
}
